#!/bin/bash
#SBATCH --partition=CPU_rune
#SBATCH --nodelist=
#SBATCH -J XIV2_opt
#SBATCH -N 1
#SBATCH --ntasks-per-node=40
#SBATCH --cpus-per-task=1

source /usr/local/_tci_software_environment_.sh
module purge
module load rune/crystal/23_v1.0.1_omp

#set some necessary environment before running
export CRY23_SCRDIR="/scratch/lme"
export CRY17_SCRDIR="/scratch/lme"
# hybrid MPI/OpenMP build: 40 MPI processes x 1 OpenMP thread = 40 cores
export OMP_NUM_THREADS=1

#run your job
runmpi23 40 xiv_c00002
grep -q "OPT END - CONVERGED" xiv_c00002.out || { echo "optimisation not converged / CRYSTAL failed"; exit 1; }

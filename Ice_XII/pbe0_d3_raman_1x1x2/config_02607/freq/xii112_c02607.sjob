#!/bin/bash
#SBATCH --partition=CPU_rune
#SBATCH --nodelist=
#SBATCH -J XII1122607_freq
#SBATCH -N 1
#SBATCH --ntasks-per-node=40
#SBATCH --cpus-per-task=1

source /usr/local/_tci_software_environment_.sh
module purge
module load rune/crystal/17_v1.0.2

#set some necessary environment before running
export CRY17_SCRDIR="/scratch/lme"

#run your job
# run only if the optimisation converged; its geometry (with symmetry) -> fort.34
grep -q "OPT END - CONVERGED" ../opt/xii112_c02607.out 2>/dev/null || { echo 'optimisation not converged - frequencies skipped'; exit 1; }
cp ../opt/xii112_c02607.gui ./xii112_c02607.gui || { echo 'opt geometry missing'; exit 1; }
runmpi17 40 xii112_c02607
